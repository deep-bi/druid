# Fake skopeo for run-tests.sh. "skopeo copy [options] docker://<registry>/<repository>@<digest>
# docker://<registry>/<repository>:<tag>" points the tag at the digest in the file registry of the fake
# curl, $FAKE_REGISTRY/<registry>/<repository>/<tag>.

set -euo pipefail

if [[ "${1:-}" != copy || $# -lt 3 ]]; then
  echo "fake skopeo: unsupported command: $*" >&2
  exit 2
fi
from="${*: -2:1}"
to="${*: -1}"
from="${from#docker://}"
to="${to#docker://}"
if [[ "${from}" != *@* || "${to}" == *@* ]]; then
  echo "fake skopeo: expected a copy from a digest to a tag, got ${from} -> ${to}" >&2
  exit 2
fi

target="${FAKE_REGISTRY:?FAKE_REGISTRY is not set}/${to%:*}/${to##*:}"
mkdir -p "$(dirname "${target}")"
echo "${from##*@}" > "${target}"
