# Fake gh for run-tests.sh. "gh api <path> [--paginate] [--jq <filter>]" answers with the file
# $FAKE_GH/<path without the query>.json, or fails the way gh does on a 404 when there is none.

set -euo pipefail

if [[ "${1:-}" != api ]]; then
  echo "fake gh: unsupported command: $*" >&2
  exit 2
fi
shift
path=""
filter=""
while (( $# > 0 )); do
  case "$1" in
    --paginate) ;;
    --jq) filter=$2; shift ;;
    -*) echo "fake gh: unsupported option $1" >&2; exit 2 ;;
    *) path=$1 ;;
  esac
  shift
done

file="${FAKE_GH:?FAKE_GH is not set}/${path%%\?*}.json"
if [[ ! -f "${file}" ]]; then
  echo "gh: Not Found (HTTP 404)" >&2
  exit 1
fi
if [[ -n "${filter}" ]]; then
  jq -r "${filter}" "${file}"
else
  cat "${file}"
fi
